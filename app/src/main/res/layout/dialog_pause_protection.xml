<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the warning and all pause durations in one AlertDialog content view.
     AlertDialog.setMessage() and setItems() compete for the same panel. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/pauseWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pause_protection_warning"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/pauseFiveMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/pause_5_minutes" />

        <Button
            android:id="@+id/pauseFifteenMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/pause_15_minutes" />

        <Button
            android:id="@+id/pauseThirtyMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/pause_30_minutes" />
    </LinearLayout>
</ScrollView>
