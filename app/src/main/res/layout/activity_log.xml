<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp">

    <Button
        android:id="@+id/logBackButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/pill_outline"
        android:text="@string/back_to_dashboard"
        android:textAllCaps="false"
        android:textColor="@color/text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/activity_log_title"
        android:textColor="@color/text"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/activity_log_subtitle"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/domainSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/search_domains"
        android:inputType="text"
        android:singleLine="true"
        android:maxLength="253"
        android:textColor="@color/text"
        android:textColorHint="@color/muted" />

    <RadioGroup
        android:id="@+id/logFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/filterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/amber"
            android:checked="true"
            android:text="@string/filter_all"
            android:textColor="@color/text"
            android:textSize="12sp" />
        <RadioButton
            android:id="@+id/filterBlocked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/amber"
            android:text="@string/filter_blocked"
            android:textColor="@color/text"
            android:textSize="12sp" />
        <RadioButton
            android:id="@+id/filterAllowed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/amber"
            android:text="@string/filter_allowed"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/logSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/logEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp" />
    </ScrollView>
</LinearLayout>
